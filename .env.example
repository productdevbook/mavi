# Used by docker-compose.yml. Copy to .env and adjust as needed.

# --- Bundled Postgres (default) ---
POSTGRES_USER=mavi
# Required, and not a placeholder to leave as it is: this is the password to
# the database holding every site. Something nobody else has, e.g.
# The bundled compose file embeds this in DATABASE_URL, so use a URI-safe
# value such as hex rather than a raw base64 value containing `/` or `+`.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=mavi

# --- What seals a site's secrets ---
# Its mail password, its payment keys. A version, a colon, and thirty-two
# bytes of base64 — a comma and another version for each older key you are
# rotating away from. Required, and refused rather than made up if it cannot
# be read, because a key that changed is a site whose secrets will not open.
#   echo "1:$(openssl rand -base64 32)"
MAVI_KEYS=

# --- The site owned by this self-hosted process ---
# The clean runtime is fixed-site by default. Generate a new UUID for each
# installation; it is the durable identity of this site's rows.
#   uuidgen
MAVI_SITE_ID=

# --- Durable workflows (Hatchet) ---
# Separate PostgreSQL password for the bundled Hatchet server.
HATCHET_POSTGRES_PASSWORD=
# Keep the server image aligned with integrations/hatchet-worker/go.mod.
HATCHET_VERSION=v0.71.14
# The bridge secret is shared only by Mavi and the Go adapter. It is not a
# Hatchet API token and is never sent to the browser.
#   openssl rand -hex 32
MAVI_HATCHET_BRIDGE_SECRET=
# Create this token once in the Hatchet dashboard (http://localhost:8888).
MAVI_HATCHET_TOKEN=
MAVI_HATCHET_TENANT_ID=707d0855-80ab-4e1f-a156-f1c4546cbf52
MAVI_HATCHET_NAMESPACE=mavi
# Bundled Hatchet is plaintext internally; use tls/mtls for a secured external
# Hatchet endpoint and provide the corresponding SDK certificate settings.
MAVI_HATCHET_TLS_STRATEGY=none
# Hatchet-side limit for calls from the bridge to the Rust executor.
MAVI_HATCHET_RATE_LIMIT_PER_MINUTE=60
# Site-scoped maintenance/retention workflow. Hatchet owns this cron.
MAVI_HATCHET_MAINTENANCE_CRON="*/5 * * * *"
MAVI_PROCESS_ROLE=all
# Only used by the optional split worker process.
# MAVI_EXECUTOR_LISTEN=0.0.0.0:8091
# In split mode point the bridge at the private worker listener:
# MAVI_RUST_EXECUTOR_URL=http://worker:8091
# Leave empty when Mavi talks to the bundled bridge. Set this to a private
# bridge URL when the tenant repository supplies a central Hatchet adapter.
# MAVI_HATCHET_BRIDGE_URL=http://hatchet-worker:8090

# --- Optional mail gateway integration ---
# Outbound provider gateway; leave both outbound values unset to fail closed.
# MAVI_MAIL_WEBHOOK_URL=https://mail-gateway.example/send
# MAVI_MAIL_WEBHOOK_TOKEN=
# Separate inbound credential for normalized bounce/complaint events.
# MAVI_MAIL_WEBHOOK_INGEST_TOKEN=
# Deployment sender identity. When outbound mail is enabled, the address is
# required and must belong to the configured allowlist (comma-separated).
# Site settings may select another sender only inside these domains.
# MAVI_MAIL_FROM=noreply@example.com
# MAVI_MAIL_FROM_NAME=Mavi
# MAVI_MAIL_ALLOWED_SENDER_DOMAINS=example.com

# --- Backend ---
# Left unset, this is built from the three above and points at the bundled
# Postgres. Set it to reach a PostgreSQL of your own instead, and the
# "postgres" service can then be removed from docker-compose.yml.
# DATABASE_URL=postgres://user:password@host:5432/mavi
RUST_LOG=info

# --- The address it answers on ---
# Set this to your own name and Caddy asks a certificate for it on the first
# request. Left as localhost, it serves plain HTTP — right while you are
# looking at it on your own machine, wrong on one anybody else can reach.
MAVI_DOMAIN=localhost

# --- Which version to run ---
# A tag, e.g. v0.1.0. `latest` moves under you; on anything you care about,
# pin it.
MAVI_VERSION=latest
