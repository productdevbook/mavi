// One installation, one site, so one resource. Every question asked of this
// engine is "may this person do this kind of thing here", and `here` has
// stopped being a choice.
entity Site;

entity Operator;

entity SiteUser {
    grants: Set<String>,
    id: String,
};

action "view" appliesTo {
    principal: [Operator, SiteUser],
    resource: [Site],
    context: { needed: String, needed_own: String, owner: String },
};

action "write" appliesTo {
    principal: [Operator, SiteUser],
    resource: [Site],
    context: { needed: String, needed_own: String, owner: String },
};

action "delete" appliesTo {
    principal: [Operator, SiteUser],
    resource: [Site],
    context: { needed: String, needed_own: String, owner: String },
};
